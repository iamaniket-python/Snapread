{
  "provider": "python",
  "buildAptPackages": [],
  "steps": {
    "install": {
      "commands": [
        "pip install -r requirements.txt",
        "python manage.py collectstatic --noinput"
      ]
    }
  },
  "deploy": {
    "startCommand": "python manage.py migrate && gunicorn Snapread.wsgi:application --bind 0.0.0.0:$PORT"
  }
}